---
import Logo from './Logo.astro';
---

<header class="site-header reference-header" data-site-header>
  <nav class="reference-nav" aria-label="Primary navigation">
    <a class="reference-logo" href="/" aria-label="Sandikala Studio — home"><Logo /></a>
    <a class="reference-info" href="/#info">Info+</a>
  </nav>
</header>

<style>
  .reference-header{position:fixed;inset:0 0 auto;z-index:1000;height:64px;color:#fff;background:transparent}
  .reference-header:before{display:none}
  .reference-nav{display:flex;align-items:center;justify-content:space-between;width:100%;height:100%;padding:0 var(--pad);font-size:13px;line-height:1;letter-spacing:-.015em}
  .reference-logo{display:flex;width:89px;height:25px}
  .reference-logo :global(svg){width:100%;height:100%}
  .reference-logo,.reference-info{transition:opacity .2s ease}
  .reference-logo:hover,.reference-info:hover{opacity:.58}
  .reference-info{white-space:nowrap}
  @media(max-width:700px){
    .reference-header{height:54px}
    .reference-nav{font-size:12px}
    .reference-logo{width:76px;height:auto}
  }
</style>
