---
const path = Astro.url.pathname;
---

<header>
  <nav aria-label="Main navigation">
    <a href="/" class="brand">Sandikala</a>

    <div class="links">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}>Index</a>
      <span aria-hidden="true">/</span>
      <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a>
    </div>

    <time id="clock" aria-label="Current time in Bali">--:--</time>
  </nav>
</header>

<script>
  const clock = document.querySelector<HTMLTimeElement>('#clock');

  const formatter = new Intl.DateTimeFormat('en-GB', {
    timeZone: 'Asia/Makassar',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  });

  const updateClock = () => {
    if (clock) clock.textContent = formatter.format(new Date());
  };

  const scheduleClockUpdate = () => {
    updateClock();
    window.setTimeout(scheduleClockUpdate, 60_000 - (Date.now() % 60_000) + 50);
  };

  scheduleClockUpdate();
</script>

<style>
  header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--nav-height);
    background: var(--paper);
  }

  nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    height: 100%;
    padding: 0 var(--pad);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .brand,
  .links a,
  .links span {
    color: var(--muted);
  }

  .links {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .links a[aria-current="page"],
  .links a:hover {
    color: var(--ink);
  }

  time {
    margin-left: auto;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 700px) {
    nav {
      gap: var(--space-3);
    }
  }
</style>
