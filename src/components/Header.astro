---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header">
  <nav class="site-nav" aria-label="Main navigation">
    <a href="/" class="brand" aria-label="Sandikala home">Sandikala</a>
    <a href="/about" class="info-link" aria-current={path === '/about' ? 'page' : undefined}>Info+</a>
  </nav>
</header>

<style>
  .site-header { width: 100%; background: var(--paper); }
  .site-nav { display: flex; align-items: center; justify-content: space-between; min-height: var(--nav-height); padding-inline: var(--pad); }
  .brand, .info-link { color: var(--muted); }
  .brand:hover, .brand:focus-visible, .info-link:hover, .info-link:focus-visible, .info-link[aria-current='page'] { color: var(--ink); }
</style>
