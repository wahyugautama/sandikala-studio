---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <p>(C) <span>{currentYear}</span></p>
</footer>

<style>
  .site-footer {
    display: flex;
    align-items: center;
    width: min(100%, var(--max));
    margin: 0 auto;
    padding: var(--space-7) var(--pad) var(--space-2);
    color: var(--muted);
  }

  .site-footer p { margin: 0; }
</style>
