---
import Layout from '../layouts/Layout.astro';
import SplitTextReveal from '../components/SplitTextReveal.astro';

const services = [
  'Brand Identity',
  'Website Design & Art Direction',
  'Custom Development',
];
const industries = [
  'Architecture',
  'Technology',
  'Finance',
  'Lifestyle & Hospitality',
  'Culture',
  'Health & Wellness',
];
const awards = [
  'Awwwards Honorable Mention',
  'Orpetron Web Design of the Day',
  'CSSDA Special Kudos',
  'CSSDA Best Innovation',
  'CSSDA Best UX & UI Design',
];
---

<Layout
  title="About — Sandikala Studio"
  description="Sandikala is an independent creative practice by Wahyu, crafting distinctive brands and websites."
>
  <section class="about-page" aria-label="About Sandikala Studio">
    <div class="about-introduction">
      <h1>
        Sandikala is an independent creative practice by Wahyu, crafting
        distinctive brands and websites for businesses starting something new or
        ready to be seen differently.
      </h1>
      <SplitTextReveal>
        I work directly with founders and creative teams, shaping ideas from
        early concepts to finished experiences. Small by choice, a little
        obsessive about design, and personally involved in every project.
      </SplitTextReveal>
    </div>

    <section class="about-approach" aria-labelledby="approach-title">
      <h2 id="approach-title">Approach</h2>
      <div class="approach-copy">
        <SplitTextReveal>
          I don't believe in having a fixed style. I'd rather understand what
          makes each project different, question the obvious, and explore what's
          possible.
        </SplitTextReveal>
        <SplitTextReveal>
          I enjoy experimenting with design and technology, but being different
          isn't enough on its own. Every creative decision needs to earn its
          place, whether it helps communicate an idea, makes something easier to
          use, or gives the work a bit more character.
        </SplitTextReveal>
        <SplitTextReveal>
          Good design should look the part, feel the part, and do its part.
        </SplitTextReveal>
      </div>
    </section>

    <div class="about-sections">
      <section class="about-section" aria-labelledby="services-title">
        <h2 id="services-title">Services</h2>
        <ul>
          {services.map((service) => (
            <li>{service}</li>
          ))}
        </ul>
      </section>
      <section class="about-section" aria-labelledby="industries-title">
        <h2 id="industries-title">Industries</h2>
        <ul>
          {industries.map((industry) => (
            <li>{industry}</li>
          ))}
        </ul>
      </section>
      <section
        class="about-section about-awards"
        aria-labelledby="awards-title"
      >
        <h2 id="awards-title">Awards</h2>
        <ul>
          {awards.map((award) => (
            <li>{award}</li>
          ))}
        </ul>
      </section>
    </div>

    <div class="about-contact" id="contact">
      <a href="mailto:hello@sandikalastudio.com">hello@sandikalastudio.com</a>
      <a
        href="https://cal.com/sandikalastudio/discoverycall"
        target="_blank"
        rel="noopener noreferrer"
      >
        Schedule a Call ↗
      </a>
    </div>
  </section>
</Layout>

<style>
  .about-page {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 1rem;
    row-gap: var(--space-7);
    width: min(100%, var(--max));
    margin: auto;
    padding: var(--space-6) var(--pad) var(--space-3);
  }
  .about-introduction {
    grid-column: 1/8;
    display: grid;
    gap: var(--space-3);
    color: var(--ink);
  }
  .about-introduction h1,
  .about-introduction p {
    margin: 0;
  }
  .about-approach {
    grid-column: 1/-1;
    display: grid;
    grid-template-columns: subgrid;
  }
  .about-approach h2 {
    grid-column: 1/4;
    margin: 0;
    color: var(--muted);
  }
  .approach-copy {
    grid-column: 4/10;
    display: grid;
    gap: var(--space-3);
  }
  .approach-copy p {
    margin: 0;
    color: var(--ink);
  }
  .about-sections {
    grid-column: 1/-1;
    display: grid;
    grid-template-columns: subgrid;
  }
  .about-section:nth-child(1) {
    grid-column: 1/4;
  }
  .about-section:nth-child(2) {
    grid-column: 4/7;
  }
  .about-section:nth-child(3) {
    grid-column: 7/-1;
  }
  .about-section h2 {
    margin: 0 0 var(--space-3);
    color: var(--muted);
  }
  .about-section ul {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .about-section li {
    color: var(--ink);
  }
  .about-contact {
    grid-column: 1/-1;
    display: grid;
    grid-template-columns: subgrid;
  }
  .about-contact > a:first-child {
    grid-column: 1/7;
  }
  .about-contact > a:last-child {
    grid-column: 7/-1;
  }
  .about-contact > a {
    transition: color var(--duration-fast) ease;
  }
  .about-contact > a:hover,
  .about-contact > a:focus-visible {
    color: var(--muted);
  }
  @media (max-width: 700px) {
    .about-page {
      display: flex;
      flex-direction: column;
      gap: 0;
      padding-top: var(--space-4);
      padding-bottom: var(--space-6);
    }
    .about-introduction {
      margin-bottom: var(--space-7);
    }
    .about-approach {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    .about-approach h2,
    .approach-copy {
      grid-column: auto;
    }
    .about-sections {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-6);
      margin-top: var(--space-7);
    }
    .about-section:nth-child(n) {
      grid-column: auto;
    }
    .about-contact {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-2);
      margin-top: var(--space-7);
    }
    .about-contact > a:first-child,
    .about-contact > a:last-child {
      grid-column: auto;
    }
  }
</style>
