---
import Layout from '../layouts/Layout.astro';
import { getProjectSummaries } from '../data/projects';

const projects = await getProjectSummaries();
const services = [...new Set(projects.flatMap((project) => project.services))];
const awards = [
  { platform: 'CSS Design Awards', name: 'Special Kudos', year: '2025', href: 'https://www.cssdesignawards.com/' },
  { platform: 'Awwwards', name: 'Site of the Day', year: '2024', href: 'https://www.awwwards.com/' },
  { platform: 'CSS Design Awards', name: 'UI, UX & Innovation', year: '2024', href: 'https://www.cssdesignawards.com/' },
];
---

<Layout title="About — Sandikala Studio" description="Sandikala is an independent design and development studio based in Bali, Indonesia.">
  <section class="about-page" aria-label="About Sandikala Studio">
    <h1 class="about-introduction">Sandikala is an independent design and development studio for businesses ready to make their next chapter clear, distinct, and useful.</h1>

    <div class="about-sections">
      <section class="about-section" aria-labelledby="services-title">
        <h2 id="services-title">Services</h2>
        <ul>
          {services.map((service) => <li>{service}</li>)}
        </ul>
      </section>
      <section class="about-section about-awards" aria-labelledby="awards-title">
        <h2 id="awards-title">Awards</h2>
        <ul>
          {awards.map((award) => (
            <li>
              <span>{award.platform}</span>
              <span>{award.name}</span>
              <span>{award.year}</span>
              <a href={award.href} target="_blank" rel="noopener noreferrer" aria-label={`View ${award.name} on ${award.platform}`}>
                View ↗
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <div class="about-contact" id="contact">
      <a href="mailto:hello@sandikalastudio.com">hello@sandikalastudio.com</a>
      <a href="https://cal.com/sandikalastudio/discoverycall" target="_blank" rel="noopener noreferrer">Schedule a Call ↗</a>
      <p>Engagements start at USD 5,000.</p>
    </div>
  </section>
</Layout>

<style>
  .about-page{display:grid;grid-template-rows:minmax(0,1fr) auto auto;gap:var(--space-4);min-height:100dvh;width:min(100%,var(--max));margin:auto;padding:calc(var(--nav-height) + var(--space-2)) var(--pad) var(--space-3)}
  .about-introduction{max-width:31ch;margin:0;color:var(--ink)}
  .about-sections{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-4)}
  .about-section h2{margin:0 0 var(--space-3);color:var(--muted)}.about-section ul{display:grid;gap:var(--space-1);margin:0;padding:0;list-style:none}.about-section li{color:var(--ink)}.about-awards li{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr) auto auto;gap:var(--space-2);align-items:baseline}.about-awards li span:nth-child(3){color:var(--muted);font-variant-numeric:tabular-nums}.about-awards a{color:var(--muted);transition:color var(--duration-fast) ease}.about-awards a:hover,.about-awards a:focus-visible{color:var(--ink)}
  .about-contact{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-4)}.about-contact p{margin:0;color:var(--muted)}.about-contact>a{transition:color var(--duration-fast) ease}.about-contact>a:hover,.about-contact>a:focus-visible{color:var(--muted)}
  @media(max-width:700px){.about-page{display:flex;min-height:100dvh;padding-top:calc(var(--nav-height) + var(--space-4));padding-bottom:var(--space-6)}.about-introduction{margin-bottom:var(--space-7)}.about-sections{grid-template-columns:1fr;gap:var(--space-6)}.about-awards li{grid-template-columns:minmax(0,1fr) auto auto}.about-awards li span:first-child{grid-column:1/-1;color:var(--muted)}.about-contact{grid-template-columns:1fr;gap:var(--space-2);margin-top:var(--space-7)}}
</style>
