---
import Layout from '../layouts/Layout.astro';
import { getProjects } from '../data/projects';

const projects = await getProjects();
---

<Layout
  title="Sandikala — Independent Brand & Web Studio"
  description="Sandikala helps established businesses bring their brand and website in line with where they are going."
  hideFooter
>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
      <h1 id="home-title">Independent<br />brand &amp; web studio.</h1>
    </section>

    <section class="selected-work" id="info" aria-labelledby="work-title">
      <div class="work-heading">
        <p>Selected work</p>
        <h2 id="work-title">Projects shaped<br />with intention.</h2>
      </div>

      <div class="work-table" aria-label="Selected projects">
        <div class="work-columns" aria-hidden="true">
          <span>Client</span>
          <span>Service</span>
          <span>Industry</span>
        </div>
        {projects.map((project) => (
          <a class="work-row" href={project.href} aria-label={`View ${project.clientName} case study`}>
            <span class="work-client">{project.clientName}</span>
            <span class="work-service"><span class="work-mobile-label">Service</span>{project.services[0]}</span>
            <span class="work-industry"><span class="work-mobile-label">Industry</span>{project.industry}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .home-page{display:grid;grid-template-rows:minmax(0,1fr) auto;gap:var(--space-3);min-height:100dvh;width:min(100%,var(--max));margin:auto;padding:calc(var(--nav-height) + var(--space-2)) var(--pad) var(--space-2)}
  .home-hero{display:flex;align-items:flex-end;min-height:0;padding-bottom:var(--space-2)}
  .home-hero h1{margin:0;color:var(--ink)}
  .selected-work{min-width:0}
  .work-heading{display:grid;grid-template-columns:minmax(8rem,1fr) 3fr;gap:var(--space-4);margin-bottom:var(--space-2)}
  .work-heading p,.work-mobile-label{color:var(--muted)}
  .work-heading p{margin:0}.work-heading h2{margin:0;color:var(--ink)}
  .work-table{border-top:1px solid var(--line)}
  .work-columns,.work-row{display:grid;grid-template-columns:minmax(0,2fr) minmax(9rem,.75fr) minmax(8rem,.65fr);gap:var(--space-4);align-items:baseline}
  .work-columns{padding:var(--space-1) 0;color:var(--muted);border-bottom:1px solid var(--line)}
  .work-row{padding:var(--space-1) 0;color:var(--ink);border-bottom:1px solid var(--line)}
  .work-client{color:var(--ink)}.work-service,.work-industry{color:var(--muted);transition:color var(--duration-fast) ease}.work-row:hover .work-service,.work-row:hover .work-industry,.work-row:focus-visible .work-service,.work-row:focus-visible .work-industry{color:var(--ink)}.work-mobile-label{display:none}
  @media(max-width:700px){.home-page{display:block;min-height:100dvh;padding:calc(var(--nav-height) + var(--space-4)) var(--pad) var(--space-6)}.home-hero{min-height:65svh;padding-bottom:var(--space-5)}.work-heading{grid-template-columns:1fr;gap:var(--space-3);margin-bottom:var(--space-3)}.work-columns{display:none}.work-row{grid-template-columns:1fr 1fr;gap:var(--space-2);padding:var(--space-3) 0}.work-client{grid-column:1/-1}.work-service,.work-industry{display:grid;gap:var(--space-1)}.work-mobile-label{display:block}}
</style>
