---
import Layout from '../../layouts/Layout.astro';
import { getProjects, type Project } from '../../data/projects';

interface Props {
  project: Project;
}

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const galleryImages = project.imageGallery.length ? project.imageGallery : project.mainImage ? [project.mainImage] : [];
const description = project.projectOverview || `${project.title} project by Sandikala Studio.`;
---

<Layout
  title={`${project.title} — Sandikala Studio`}
  description={description}
  hideFooter
>
  <article class="project-detail">
    <header class="project-information">
      <h1>{project.title}</h1>
      {project.year && <p class="project-year">{project.year}</p>}
      {project.projectOverview && <p class="project-description">{project.projectOverview}</p>}
      {project.projectUrl && (
        <p class="project-link">
          <a href={project.projectUrl} target="_blank" rel="noopener noreferrer">{project.projectUrl} ↗</a>
        </p>
      )}
    </header>

    {galleryImages.length > 0 && (
      <section class="project-gallery" aria-label={`${project.title} image gallery`}>
        {galleryImages.map((image, index) => (
          <figure>
            <img
              src={image.url}
              alt={image.alt.trim() || `${project.title} project image ${index + 1}`}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </figure>
        ))}
      </section>
    )}
  </article>
</Layout>

<style>
  .project-detail{width:min(100%,var(--max));margin:0 auto;padding:calc(var(--nav-height) + var(--space-6)) var(--pad) var(--space-7)}
  .project-information{max-width:52rem;margin-bottom:var(--space-7)}
  .project-information h1{margin:0 0 var(--space-3);font-size:clamp(2.25rem,5vw,5rem);line-height:1.05;letter-spacing:-.04em}
  .project-year{margin:0 0 var(--space-5);color:var(--muted);font-variant-numeric:tabular-nums}
  .project-description{max-width:65ch;margin:0}
  .project-link{margin:var(--space-4) 0 0;overflow-wrap:anywhere}
  .project-link a{text-decoration:underline;text-underline-offset:.15em}
  .project-gallery figure{margin:0}
  .project-gallery figure+figure{margin-top:var(--space-4)}
  .project-gallery img{width:100%;height:auto}
  @media(max-width:700px){.project-detail{padding-top:calc(var(--nav-height) + var(--space-4));padding-bottom:var(--space-6)}.project-information{margin-bottom:var(--space-5)}.project-year{margin-bottom:var(--space-4)}.project-gallery figure+figure{margin-top:var(--space-3)}}
</style>
