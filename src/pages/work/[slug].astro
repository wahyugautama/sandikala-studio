---
import Layout from '../../layouts/Layout.astro';
import { projects, type Project } from '../../data/projects';

interface Props { project: Project; }

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const gallery = [
  { src: project.mainImageUrl, alt: project.mainImage.alt || `${project.clientName} project` },
  ...(project.imageGallery ?? [])
    .map((image) => ({ src: image.url, alt: image.alt || '' }))
    .filter(({ src }) => src && src !== project.mainImageUrl),
];
const galleryCopies = 3;
---

<Layout
  title={`${project.clientName} — Sandikala Studio`}
  description={project.projectOverview}
  hideFooter
  pageType="work"
>
  <article class="work-detail">
    <div class="work-close-column">
      <a class="work-close" href="/" aria-label="Close project and return home" data-work-close>
        <span></span><span></span>
      </a>
    </div>

    <aside class="work-information" aria-label="Project information">
      <dl class="work-metadata">
        <div><dt>Client</dt><dd>{project.clientName}</dd></div>
        <div><dt>Year</dt><dd>{project.year}</dd></div>
        <div><dt>Industry</dt><dd>{project.industry}</dd></div>
        <div><dt>Scope</dt><dd>{project.services.join(', ')}</dd></div>
      </dl>
    </aside>

    <section class="work-images" aria-label={`${project.clientName} project gallery`} data-infinite-gallery>
      {Array.from({ length: galleryCopies }, (_, copyIndex) => (
        <div class="work-images-copy" data-gallery-copy aria-hidden={copyIndex === 1 ? undefined : 'true'}>
          {gallery.map((image, imageIndex) => (
            <img
              class="work-image"
              src={image.src}
              alt={copyIndex === 1 ? image.alt : ''}
              loading={copyIndex === 1 && imageIndex === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          ))}
        </div>
      ))}
    </section>
  </article>
</Layout>

<script>
  const initInfiniteGallery = () => {
    const gallery = document.querySelector<HTMLElement>('[data-infinite-gallery]');
    if (!gallery || gallery.dataset.ready === 'true') return;
    gallery.dataset.ready = 'true';

    const copies = Array.from(gallery.querySelectorAll<HTMLElement>('[data-gallery-copy]'));
    if (copies.length !== 3) return;

    let segmentHeight = 0;
    let isRecentering = false;

    const measure = () => {
      segmentHeight = copies[1].offsetHeight;
      if (segmentHeight > 0 && gallery.scrollTop < segmentHeight * .5) {
        gallery.scrollTop = segmentHeight;
      }
    };

    const recenter = () => {
      if (isRecentering || segmentHeight <= 0) return;
      if (gallery.scrollTop < segmentHeight * .5) {
        isRecentering = true;
        gallery.scrollTop += segmentHeight;
      } else if (gallery.scrollTop >= segmentHeight * 1.5) {
        isRecentering = true;
        gallery.scrollTop -= segmentHeight;
      } else {
        return;
      }
      requestAnimationFrame(() => { isRecentering = false; });
    };

    const observer = new ResizeObserver(measure);
    observer.observe(copies[1]);
    gallery.addEventListener('scroll', recenter, { passive: true });
    gallery.querySelectorAll('img').forEach((image) => image.addEventListener('load', measure));
    measure();
  };

  initInfiniteGallery();
  document.addEventListener('astro:page-load', initInfiniteGallery);
</script>

<style>
  .work-detail {
    display: grid;
    grid-template-columns: 18.75vw 31.05vw minmax(0, 1fr);
    min-height: 100svh;
    background: #f7f7f7;
    color: #747474;
  }

  .work-close-column {
    position: relative;
    min-width: 0;
  }

  .work-close {
    position: fixed;
    top: 78px;
    left: 10px;
    z-index: 10;
    display: block;
    width: 20px;
    height: 20px;
    color: #aaa;
  }

  .work-close span {
    position: absolute;
    top: 9.5px;
    left: -2px;
    width: 24px;
    height: 1px;
    background: currentColor;
    transition: color 180ms ease, transform 250ms ease;
  }

  .work-close span:first-child { transform: rotate(45deg); }
  .work-close span:last-child { transform: rotate(-45deg); }
  .work-close:hover { color: #34352d; }
  .work-close:hover span:first-child { transform: rotate(135deg); }
  .work-close:hover span:last-child { transform: rotate(45deg); }

  .work-information {
    position: relative;
    min-width: 0;
  }

  .work-metadata {
    position: sticky;
    top: 79px;
    display: grid;
    gap: 9px;
    width: min(19rem, calc(100% - 2rem));
    padding-left: 11px;
  }

  .work-metadata div { display: grid; gap: 0; }
  .work-metadata dt,
  .work-metadata dd {
    margin: 0;
    font-size: 13px;
    line-height: 1.12;
    font-weight: 400;
  }
  .work-metadata dt { color: #b3b3b3; }
  .work-metadata dd { color: #707070; }

  .work-images {
    position: sticky;
    top: 0;
    min-width: 0;
    height: 100svh;
    overflow-y: auto;
    background: #e8e8e8;
    scrollbar-width: none;
  }

  .work-images::-webkit-scrollbar { display: none; }

  .work-images-copy { display: block; }

  .work-image {
    display: block;
    width: 100%;
    height: auto;
    margin: 0;
  }

  @media (max-width: 700px) {
    .work-detail {
      display: block;
      padding-top: 0;
    }

    .work-close-column {
      position: absolute;
      inset: 0 auto auto 0;
    }

    .work-close {
      position: fixed;
      top: 76px;
      left: 14px;
      width: 22px;
      height: 22px;
      padding: 4px;
      background: rgba(247, 247, 247, .9);
      border-radius: 50%;
    }

    .work-close span {
      top: 10.5px;
      left: 2px;
      width: 18px;
    }

    .work-information {
      min-height: 15rem;
      padding: 6.5rem 1rem 2rem 4rem;
    }

    .work-metadata {
      position: static;
      width: 100%;
      padding: 0;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .work-images {
      position: relative;
      height: 100svh;
    }
  }
</style>
