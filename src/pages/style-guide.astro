---
import Layout from '../layouts/Layout.astro';

const colors = [
  { name: 'Paper', token: '--paper', value: '#F2F0EA', use: 'Primary canvas' },
  { name: 'Ink', token: '--ink', value: '#34352D', use: 'Primary text & marks' },
  { name: 'Muted', token: '--muted', value: '#747468', use: 'Supporting text' },
  { name: 'Lime', token: '--lime', value: '#D8FF43', use: 'Selection & emphasis' },
  { name: 'Line', token: '--line', value: '22% Ink', use: 'Rules & dividers' },
];

const typeScale = [
  { name: 'Display', token: '--text-display', sample: 'Living systems' },
  { name: 'Heading', token: '--text-xl', sample: 'Clarity has character.' },
  { name: 'Body large', token: '--text-lg', sample: 'A considered voice for thoughtful brands.' },
  { name: 'Body', token: '--text-base', sample: 'The standard reading size for interface and narrative copy.' },
  { name: 'Label', token: '--text-xs', sample: 'SYSTEM REFERENCE' },
];

const spaces = [
  ['01', '--space-1', '8px'], ['02', '--space-2', '16px'], ['03', '--space-3', '24px'], ['04', '--space-4', '32px'],
  ['05', '--space-5', '48px'], ['06', '--space-6', '64px'], ['07', '--space-7', '96px'], ['08', '--space-8', '128px'],
];
---

<Layout title="Style Guide — Sandikala Studio" description="Sandikala Studio’s visual foundation: typography, color, and spacing.">
  <section class="guide-hero">
    <p class="guide-kicker">Sandikala / Style guide</p>
    <h1>Built for<br /><em>clear expression.</em></h1>
    <p>Our shared visual language, distilled into the elements that shape every touchpoint.</p>
  </section>

  <section class="guide-section" aria-labelledby="type-title">
    <div class="guide-intro">
      <p class="guide-label">01 / Typography</p>
      <div>
        <h2 id="type-title">One voice,<br />many registers.</h2>
        <p class="guide-summary">PP Mori is the foundation: open, precise, and comfortably human. A serif accent is reserved for moments that need a little softness.</p>
      </div>
    </div>
    <div class="type-list">
      {typeScale.map((item) => (
        <article class="type-row">
          <div class="type-meta"><span>{item.name}</span><code>{item.token}</code></div>
          <p class:list={[item.name === 'Label' && 'type-label']} style={`font-size:var(${item.token})`}>{item.sample}</p>
        </article>
      ))}
    </div>
    <div class="font-note"><span>Typeface</span><strong>PP Mori Regular</strong><span>400 / Normal</span></div>
  </section>

  <section class="guide-section guide-colors" aria-labelledby="color-title">
    <div class="guide-intro">
      <p class="guide-label">02 / Colour</p>
      <div>
        <h2 id="color-title">Quiet tones,<br />one bright signal.</h2>
        <p class="guide-summary">The palette stays close to paper and ink, letting the acid lime focus attention where it matters.</p>
      </div>
    </div>
    <div class="color-grid">
      {colors.map((color) => (
        <article class="color-card">
          <div class="color-swatch" style={`background:var(${color.token})`}></div>
          <div class="color-info"><div><h3>{color.name}</h3><code>{color.token}</code></div><p>{color.value}<br />{color.use}</p></div>
        </article>
      ))}
    </div>
  </section>

  <section class="guide-section guide-spacing" aria-labelledby="space-title">
    <div class="guide-intro">
      <p class="guide-label">03 / Spacing</p>
      <div>
        <h2 id="space-title">Space makes<br />the rhythm.</h2>
        <p class="guide-summary">A restrained scale keeps layouts calm while leaving room for images and ideas to breathe.</p>
      </div>
    </div>
    <div class="space-list">
      {spaces.map(([number, token, value]) => (
        <div class="space-row"><span>{number}</span><code>{token}</code><span>{value}</span><div class="space-bar" style={`width:var(${token})`}></div></div>
      ))}
    </div>
    <aside class="layout-note"><span>Layout tokens</span><p><code>--pad</code> creates the responsive outer gutter. <code>--section</code> defines vertical section rhythm. <code>--max</code> caps the content width at 1600px.</p></aside>
  </section>
</Layout>

<style>
  .guide-hero{display:grid;grid-template-columns:1fr minmax(0,2fr);gap:var(--space-4);min-height:86svh;padding:clamp(8rem,18vh,12rem) var(--pad) var(--space-5);color:var(--paper);background:var(--dark)}
  .guide-kicker,.guide-label,.type-meta,code,.font-note,.layout-note>span{font-size:var(--text-xs);line-height:1.2;letter-spacing:.11em;text-transform:uppercase}
  .guide-hero h1{grid-column:1/-1;align-self:end;max-width:9ch;margin:0;font-size:clamp(4.5rem,12vw,13rem);font-weight:400;line-height:.77;letter-spacing:-.08em}
  .guide-hero h1 em{font-family:Georgia,serif;font-weight:400;color:var(--lime)}
  .guide-hero>p:last-child{grid-column:2;max-width:30ch;font-size:var(--text-lg);line-height:1.35}
  .guide-section{width:min(100%,var(--max));margin:auto;padding:var(--section) var(--pad);border-bottom:1px solid var(--line)}
  .guide-intro{display:grid;grid-template-columns:minmax(8rem,1fr) 3fr;gap:var(--space-4);margin-bottom:clamp(3rem,7vw,7rem)}
  .guide-intro h2{max-width:12ch;margin:0;font-size:var(--text-xl);font-weight:400;line-height:.93;letter-spacing:-.06em}
  .guide-summary{max-width:37ch;margin:var(--space-4) 0 0;font-size:var(--text-lg);line-height:1.35;color:var(--muted)}
  .type-list{border-top:1px solid var(--line)}
  .type-row{display:grid;grid-template-columns:minmax(10rem,1fr) 3fr;gap:var(--space-4);align-items:baseline;padding:var(--space-3) 0;border-bottom:1px solid var(--line)}
  .type-meta{display:flex;flex-direction:column;gap:.35rem;color:var(--muted)}
  .type-row p{margin:0;line-height:.95;letter-spacing:-.045em}.type-row .type-label{letter-spacing:.12em;line-height:1.2}
  .font-note{display:flex;justify-content:space-between;gap:var(--space-3);padding-top:var(--space-2);color:var(--muted)}.font-note strong{font-weight:400;color:var(--ink)}
  .color-grid{display:grid;grid-template-columns:repeat(5,1fr);border-top:1px solid var(--line)}
  .color-card{min-width:0;padding:var(--space-2) 0 0}.color-card+.color-card{padding-left:var(--space-2);border-left:1px solid var(--line)}
  .color-swatch{height:clamp(8rem,18vw,16rem);border:1px solid var(--line)}.color-info{display:grid;gap:var(--space-2);padding:var(--space-2) 0 0 var(--space-2)}.color-info h3{margin:0 0 .35rem;font-size:var(--text-sm);font-weight:400}.color-info code{color:var(--muted)}.color-info p{margin:0;font-size:var(--text-xs);line-height:1.5;color:var(--muted)}
  .space-list{border-top:1px solid var(--line)}.space-row{display:grid;grid-template-columns:3rem minmax(9rem,1fr) 4rem minmax(0,2fr);gap:var(--space-2);align-items:center;min-height:4.25rem;border-bottom:1px solid var(--line);font-size:var(--text-xs);color:var(--muted)}.space-row code{color:var(--ink)}.space-bar{height:.85rem;min-width:.5rem;background:var(--lime)}
  .layout-note{display:grid;grid-template-columns:minmax(8rem,1fr) 3fr;gap:var(--space-4);margin-top:var(--space-5);padding-top:var(--space-2);border-top:1px solid var(--line)}.layout-note p{max-width:48ch;margin:0;color:var(--muted)}.layout-note code{color:var(--ink)}
  @media(max-width:700px){.guide-hero{grid-template-columns:1fr;min-height:75svh}.guide-hero>p:last-child{grid-column:1}.guide-intro,.type-row,.layout-note{grid-template-columns:1fr}.guide-label{margin-bottom:var(--space-2)}.type-row{gap:var(--space-2)}.color-grid{grid-template-columns:repeat(2,1fr)}.color-card:nth-child(odd){padding-left:0;border-left:0}.color-card:nth-child(n+3){margin-top:var(--space-3)}.color-card:last-child{grid-column:1/-1}.font-note{flex-direction:column;gap:.45rem}.space-row{grid-template-columns:2rem minmax(0,1fr) 3rem}.space-bar{grid-column:2/-1;width:100%!important;height:.35rem}.layout-note{gap:var(--space-2)}}
</style>
